<!--@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-->
  
  <link name="fork_front_right">
    <visual>
      <origin xyz="0.3 0.47 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://my_robot_description/meshes/fork_front_right.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="forks">
        <color rgba="0.2 0.2 0.2 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.3 0.47 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://my_robot_description/meshes/fork_front_right.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0680 -0.0015 -0.0941" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.0207" ixy="0.0" ixz="0.0007" 
               iyy="0.0286" iyz="0.0" 
               izz="0.0114" />
    </inertial>

    <gazebo reference="fork_front_right">
    <self_collide>false</self_collide>
    </gazebo>
  </link>
  


<joint name="fork_front_right_to_suspension_arm_front_right" type="revolute">
