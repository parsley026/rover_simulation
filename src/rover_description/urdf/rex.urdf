          <ode>
            <mu>0.5</mu>
            <mu2>1</mu2>
            <slip1>0.00062</slip1>
            <slip2>0</slip2>
            <fdir1>0 0 1</fdir1>
          </ode>
        </friction>
      </surface>
    </collision> 
  </gazebo>

