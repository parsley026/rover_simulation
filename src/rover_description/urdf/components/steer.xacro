<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find rover_description)/urdf/common/inertias.xacro"/>
  <xacro:include filename="$(find rover_description)/urdf/components/drive.xacro"/>

  <xacro:macro name="steer_assembly" params="prefix parent_link origin_xyz reflect_y wheel_prefix">
    <joint name="steer_${prefix}_joint" type="revolute">
      <parent link="${parent_link}"/>
      <child link="steer_${prefix}"/>
      <origin xyz="${origin_xyz}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="${steer_effort}" lower="-${steer_limit}" upper="${steer_limit}" velocity="${steer_vel}"/>
      <dynamics damping="${steer_joint_damping}" friction="${steer_joint_friction}"/>
    </joint>

    <link name="steer_${prefix}">
      <visual><origin xyz="0 0 0.03" rpy="0 0 0"/><geometry><cylinder radius="0.045" length="0.06"/></geometry><material name="carbon_black"/></visual>
      <visual><origin xyz="0 0 -0.01" rpy="0 0 0"/><geometry><box size="0.07 0.05 0.02"/></geometry><material name="carbon_black"/></visual>
      <visual><origin xyz="0 ${-reflect_y * 0.045} -0.03" rpy="0 0 0"/><geometry><box size="0.07 0.06 0.04"/></geometry><material name="carbon_black"/></visual>
      <visual><origin xyz="0 ${-reflect_y * 0.07} -0.11" rpy="0 0 0"/><geometry><box size="0.07 0.02 0.16"/></geometry><material name="carbon_black"/></visual>
      <visual><origin xyz="0 ${-reflect_y * 0.06} -0.19" rpy="0 0 0"/><geometry><box size="0.06 0.04 0.04"/></geometry><material name="carbon_black"/></visual>
      <xacro:inertial_box mass="${mass_steer}" x="0.07" y="0.05" z="0.22">
        <origin xyz="0 ${-reflect_y * 0.02} -0.09" rpy="0 0 0"/>
      </xacro:inertial_box>
    </link>

    <xacro:drive_assembly prefix="${wheel_prefix}" parent_link="steer_${prefix}" reflect_y="${reflect_y}"/>
  </xacro:macro>
</robot>
