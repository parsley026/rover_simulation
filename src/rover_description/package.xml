<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_description</name>
  <version>0.0.0</version>
  <description>Package containing the rex robot description and related plugins.</description>
  <maintainer email="me@email.com">me_name</maintainer>
  <license>TODO: License declaration</license>

  <!-- Build tool dependency -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Build dependencies -->
  <build_depend>rclcpp</build_depend>
  <build_depend>rviz2</build_depend>
  <build_depend>urdf</build_depend>
  <build_depend>robot_state_publisher</build_depend>
  <build_depend>gazebo_ros</build_depend>
  <build_depend>gz-sim8</build_depend>
  <build_depend>gz-math7</build_depend>
  <build_depend>gz-utils2</build_depend>
  <build_depend>gz-plugin2</build_depend>
  <build_depend>gazebo_dev</build_depend>

  <!-- Execution dependencies -->
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>urdf</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gz-sim8</exec_depend>
  <exec_depend>gz-math7</exec_depend>
  <exec_depend>gz-utils2</exec_depend>
  <exec_depend>gz-plugin2</exec_depend>
  <exec_depend>gazebo_dev</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>

  <!-- Test dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
