<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find rover_description)/urdf/components/sensors/camera/luxonis/oak_d_pro_poe_camera_assembly.xacro"/>
  <xacro:macro name="sensor_camera_luxonis_oak_d_pro_poe" params="prefix parent">
    <xacro:oak_d_pro_poe_camera name="${prefix}" parent_link="${parent}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:oak_d_pro_poe_camera>
  </xacro:macro>
</robot>
