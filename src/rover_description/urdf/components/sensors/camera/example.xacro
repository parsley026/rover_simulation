<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find rover_description)/urdf/components/sensors/camera/example_camera_assembly.xacro"/>
  <xacro:macro name="sensor_camera_example" params="prefix parent">
    <xacro:camera_assembly parent_link="${parent}" camera_center_xyz="0 0 0.10"/>
  </xacro:macro>
</robot>
