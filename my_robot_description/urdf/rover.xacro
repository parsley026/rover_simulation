    <child link="fork_front_right" />

    <origin xyz="0 0.4 0" rpy="0 0 3.14" />

    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-0.4" upper="0.4" velocity="1"/>
    <dynamics friction="1.0" damping="0.1"/> 
  </joint>

