<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="mast_mounts" params="name parent_link sensor_mount_03_pitch:=0.0 sensor_mount_04_pitch:=0.0 sensor_mount_05_pitch:=0.0">


        <!-- Mount 03, 04, 05 Pivots -->
        <link name="sensor_mount_03_pivot_link">
            <visual><origin xyz="0 0 0" rpy="1.570796 0 0"/><geometry><cylinder radius="0.005" length="0.04"/></geometry><material name="mount_green"/></visual>
            <xacro:inertial_cylinder mass="0.01" length="0.04" radius="0.005"><origin xyz="0 0 0" rpy="1.570796 0 0"/></xacro:inertial_cylinder>
        </link>
        <joint name="sensor_mount_03_pivot_joint" type="fixed">
            <parent link="pole_right_link"/>
            <child link="sensor_mount_03_pivot_link"/>
            <origin xyz="0.0 0.0 0.10" rpy="0 ${sensor_mount_03_pitch * pi / 180.0} 0"/>
        </joint>
        <link name="sensor_mount_03_link">
            <visual><geometry><box size="0.02 0.04 0.035"/></geometry><material name="mount_green"/></visual>
            <xacro:inertial_box mass="0.01" x="0.02" y="0.04" z="0.035"><origin xyz="0 0 0" rpy="0 0 0"/></xacro:inertial_box>
        </link>
        <joint name="sensor_mount_03_joint" type="fixed">
            <parent link="sensor_mount_03_pivot_link"/>
            <child link="sensor_mount_03_link"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </joint>

        <!-- We'll keep 04 and 05 as well for completeness if they want extra cameras -->
        <link name="sensor_mount_04_pivot_link">
            <visual><origin xyz="0 0 0" rpy="1.570796 0 0"/><geometry><cylinder radius="0.005" length="0.04"/></geometry><material name="mount_green"/></visual>
            <xacro:inertial_cylinder mass="0.01" length="0.04" radius="0.005"><origin xyz="0 0 0" rpy="1.570796 0 0"/></xacro:inertial_cylinder>
        </link>
        <joint name="sensor_mount_04_pivot_joint" type="fixed">
            <parent link="pole_right_link"/>
            <child link="sensor_mount_04_pivot_link"/>
            <origin xyz="0.0 0.0 0.10" rpy="0 ${sensor_mount_04_pitch * pi / 180.0} 3.14159265"/>
        </joint>
        <link name="sensor_mount_04_link">
            <visual><geometry><box size="0.02 0.04 0.035"/></geometry><material name="mount_green"/></visual>
            <xacro:inertial_box mass="0.01" x="0.02" y="0.04" z="0.035"><origin xyz="0 0 0" rpy="0 0 0"/></xacro:inertial_box>
        </link>
        <joint name="sensor_mount_04_joint" type="fixed">
            <parent link="sensor_mount_04_pivot_link"/>
            <child link="sensor_mount_04_link"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </joint>

        <link name="sensor_mount_05_pivot_link">
            <visual><origin xyz="0 0 0" rpy="1.570796 0 0"/><geometry><cylinder radius="0.005" length="0.04"/></geometry><material name="mount_green"/></visual>
            <xacro:inertial_cylinder mass="0.01" length="0.04" radius="0.005"><origin xyz="0 0 0" rpy="1.570796 0 0"/></xacro:inertial_cylinder>
        </link>
        <joint name="sensor_mount_05_pivot_joint" type="fixed">
            <parent link="pole_left_link"/>
            <child link="sensor_mount_05_pivot_link"/>
            <origin xyz="0.0 0.0 0.10" rpy="0 ${sensor_mount_05_pitch * pi / 180.0} 1.57079633"/>
        </joint>
        <link name="sensor_mount_05_link">
            <visual><geometry><box size="0.02 0.04 0.035"/></geometry><material name="mount_green"/></visual>
            <xacro:inertial_box mass="0.01" x="0.02" y="0.04" z="0.035"><origin xyz="0 0 0" rpy="0 0 0"/></xacro:inertial_box>
        </link>
        <joint name="sensor_mount_05_joint" type="fixed">
            <parent link="sensor_mount_05_pivot_link"/>
            <child link="sensor_mount_05_link"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </joint>

    </xacro:macro>

</robot>
