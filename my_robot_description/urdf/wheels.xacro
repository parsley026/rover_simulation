<?xml version="1.0" encoding="utf-8"?>



  <link name="wheel_rear_left">
    <visual>
      <origin xyz="-0.3 -0.4709 0.2" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://my_robot_description/meshes/wheel_rear_left.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="wheels">
        <color rgba="1.0 0.2 0.0 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="-0.3 -0.4709 0.2" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://my_robot_description/meshes/wheel_rear_left.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>

    <!--<collision>
 <origin xyz="-0.3 -0.4709 0.2" rpy="0 0 0" />
  <geometry>
    <cylinder radius="0.2" length="0.1"/>
  </geometry>
</collision>-->
   <inertial>
  <origin xyz="-0.3 -0.4709 0.2" rpy="0 0 0" />
  <mass value="1.5" />
  <inertia ixx="0.0882" ixy="0.0" ixz="0.0" iyy="0.0508" iyz="0.0" izz="0.0508" />
</inertial>


      <gazebo reference="wheel_rear_left">
          <self_collide>false</self_collide>
      </gazebo>
    
  </link>

  <gazebo reference="wheel_rear_left">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>10000000.0</kp> <kd>10.0</kd> <minDepth>0.005</minDepth>
   <maxVel>0</maxVel>
    <fdir1>1 0 0</fdir1>
    </gazebo>

  


<joint name="wheel_rear_left_to_fork_rear_left" type="continuous">
    <parent link="fork_rear_left" />
    <child link="wheel_rear_left" />

    <origin xyz="0 0 -0.2" rpy="0 0 0" />

    <axis xyz="1 0 0"/>
<dynamics friction="0.01" damping="0.1" lower="-1" upper="1" /> 
</joint>



