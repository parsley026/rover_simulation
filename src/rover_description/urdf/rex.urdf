<!-- ************************** ZED2i ************************** -->

  <!-- Camera Center -->
  <link name="zed2_camera_center">
    <inertial>
      <mass value="0.16140"/>
      <origin xyz="0 0 0"/>
      <inertia
        ixx="0.0003947" ixy="0.0" ixz="3.3365e-8"
        iyy="2.417e-5" iyz="0.0"
        izz="0.0003973"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://rover_description/meshes/zed.dae"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://rover_description/meshes/zed.dae"/>
      </geometry>
    </collision>
  </link>

  <gazebo reference="zed2_left_camera_optical_frame">
  <sensor name="zed2i_left" type="depth_camera">
    <always_on>true</always_on>
    <update_rate>20.0</update_rate>
    <visualize>false</visualize>

    <!-- Topic for depth output -->
    <topic>/model/left_camera/depth_image</topic>

    <pose relative_to='zed2_left_camera_frame'>0 0 0 0 0 0</pose>

    <camera name="zed2i_left_camera">
      <camera_info_topic>/model/left_camera/camera_info</camera_info_topic>
      <horizontal_fov>1.7633</horizontal_fov>

      <image>
        <width>640</width>
        <height>360</height>
        <format>R8G8B8</format>
      </image>

      <clip>
        <near>0.5</near>
        <far>4</far>
      </clip>

      <depth_camera>
        <output>depths</output>
        <clip>
          <near>0.45</near>
          <far>4</far>
        </clip>
      </depth_camera>

    </camera>

    <frame_id>zed2_left_camera_optical_frame</frame_id>
  </sensor>
</gazebo>

  <gazebo reference="zed2_right_camera_optical_frame">
    <sensor name="zed2i_right" type="camera">
      <always_on>true</always_on>
      <update_rate>15.0</update_rate>
      <visualize>false</visualize>
      <topic>/model/right_camera/image</topic>
      <pose relative_to='zed2_right_camera_frame'>0 0 0 0 0 0</pose>
      <camera name="zed2i_right_camera">
        <camera_info_topic>/model/right_camera/camera_info</camera_info_topic>
        <horizontal_fov>1.7633</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.2</near>
            <far>5</far>
          </clip>

          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>

          <distortion>
            <k1>-0.043693598</k1>
            <k2>0.0146164996</k2>
            <p1>-0.006573319</p1>
            <p2>-0.000216900</p2>
            <k3>0.000084328</k3>
            <center>0.5 0.5</center>
          </distortion>

          <lens>
            <type>stereographic</type>
            <scale_to_hfov>true</scale_to_hfov>
            <intrinsics>
              <cx>658.8206787109375</cx>
              <cy>372.25787353515625</cy>
            </intrinsics>
            <projection>
              <p_cx>658.8206787109375</p_cx>
            </projection>
          </lens>

      </camera>
      
      <frame_id>zed2_right_camera_optical_frame</frame_id>
      <gz_frame_id>zed2_right_camera_optical_frame</gz_frame_id>
    </sensor>
  </gazebo>


  <joint name="zed2_to_base_link" type="fixed">
    <parent link="base_link"/>
    <child link="zed2_camera_center"/>
    <origin xyz="0.37 0 0.07" rpy="0 0 0" />
  </joint>

  <joint name="zed2_left_camera_joint" type="fixed">
    <parent link="zed2_camera_center"/>
    <child link="zed2_left_camera_frame"/>
    <origin xyz="0 0.06 0" rpy="0 0 0" />
  </joint>

  <link name="zed2_left_camera_frame" />

  <joint name="zed2_left_camera_optical_joint" type="fixed">
    <origin xyz="0.025 0 0" rpy="-1.5708 0 -1.5708"/>
    <parent link="zed2_left_camera_frame"/>
    <child link="zed2_left_camera_optical_frame"/>
  </joint>

  <link name="zed2_left_camera_optical_frame"/>

  <joint name="zed2_right_camera_joint" type="fixed">
    <parent link="zed2_camera_center"/>
    <child link="zed2_right_camera_frame"/>
    <origin xyz="0 -0.06 0" rpy="0 0 0" />
  </joint>

  <link name="zed2_right_camera_frame" />

  <joint name="zed2_right_camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5708 0.0 -1.5708"/>
    <parent link="zed2_right_camera_frame"/>
    <child link="zed2_right_camera_optical_frame"/>
  </joint>

  <link name="zed2_right_camera_optical_frame"/>

  <joint name="zed2_mag_joint" type="fixed">
    <parent link="zed2_camera_center"/>
    <child link="zed2_mag_link"/>
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <link name="zed2_mag_link" />

  <gazebo reference="zed2_camera_center">
    <sensor type="imu" name="zed2_imu">
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <visualize>false</visualize>
      <topic>imu</topic>
      <plugin filename="gz-sim-imu-system"
              name="gz::sim::systems::Imu">
      </plugin>
    </sensor>
  </gazebo>


<!-- ************************** OUSTER ************************** -->

    <link name="ouster_os1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 1.5708" />
      <geometry>
        <mesh filename="package://rover_description/meshes/ouster.dae"/>
      </geometry>
    </visual>
    <collision>
       <origin xyz="0 0 0" rpy="0 0 1.5708" />
      <geometry>
        <mesh filename="package://rover_description/meshes/ouster.dae"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.4" />
      <inertia ixx="0.000583" ixy="0" ixz="0" iyy="0.000583" iyz="0" izz="0.0005" />
    </inertial>
  </link>

  <joint name="lidar_to_base_link" type="fixed">
    <parent link="base_link" />
    <child link="ouster_os1" />
    <origin xyz="0.38 0 0" rpy="0 0 0" />
  </joint>


<gazebo reference="ouster_os1">

  <sensor name="ouster_os1" type="gpu_lidar">
    <pose relative_to='ouster_os1'>0 0 0 0 0 0</pose>
    <topic>lidar</topic>
    <update_rate>20</update_rate>
    <always_on>1</always_on>
    <visualize>false</visualize>
    <frame_id>ouster_os1</frame_id>
    <gz_frame_id>ouster_os1</gz_frame_id>
    <lidar>
        <scan>
            <horizontal>
                <samples>512</samples>
                <resolution>1</resolution>
                <min_angle>-0.7853981634</min_angle>
                <max_angle>0.7853981634</max_angle>
            </horizontal>
            <vertical>
                <samples>16</samples>
                <resolution>1</resolution>
                <min_angle>-0.2617993878</min_angle>
                <max_angle>0.2617993878</max_angle>
            </vertical>
        </scan>
        <range>
            <min>0.2</min>
            <max>12.0</max>
            <resolution>0.03</resolution>
        </range>
        <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.008</stddev>
          </noise>
    </lidar>

  </sensor>
</gazebo>


