<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="sampler_base" params="name:='sampler' parent_link module_position_front:=false module_position_back:=false xyz:='0 0 0' rpy:='0 0 0'">
    <link name="${name}_mount_link">
      <visual>
        <geometry><box size="0.15 0.15 0.02"/></geometry>
        <material name="mount_dark_gray"/>
      </visual>
      <collision>
        <geometry><box size="0.15 0.15 0.02"/></geometry>
      </collision>
      <xacro:inertial_box mass="0.5" x="0.15" y="0.15" z="0.02">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_box>
    </link>

    <joint name="${name}_mount_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${name}_mount_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <link name="${name}_body_link">
      <visual>
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
        <geometry><box size="0.12 0.12 0.20"/></geometry>
        <material name="tower_yellow"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
        <geometry><box size="0.12 0.12 0.20"/></geometry>
      </collision>
      <xacro:inertial_box mass="1.0" x="0.12" y="0.12" z="0.20">
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
      </xacro:inertial_box>
    </link>

    <joint name="${name}_body_joint" type="fixed">
      <parent link="${name}_mount_link"/>
      <child link="${name}_body_link"/>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
    </joint>

    <!-- Sampling drill/probe tool link -->
    <link name="${name}_tool_link">
      <visual>
        <origin xyz="0 0 -0.075" rpy="0 0 0"/>
        <geometry><cylinder radius="0.015" length="0.15"/></geometry>
        <material name="mount_red"/>
      </visual>
      <collision>
        <origin xyz="0 0 -0.075" rpy="0 0 0"/>
        <geometry><cylinder radius="0.015" length="0.15"/></geometry>
      </collision>
      <xacro:inertial_cylinder mass="0.2" length="0.15" radius="0.015">
        <origin xyz="0 0 -0.075" rpy="0 0 0"/>
      </xacro:inertial_cylinder>
    </link>

    <joint name="${name}_tool_joint" type="fixed">
      <parent link="${name}_body_link"/>
      <child link="${name}_tool_link"/>
      <origin xyz="0.06 0 0.05" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
