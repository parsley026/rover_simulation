<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="sensor_generic_camera" params="prefix parent">
    <link name="${prefix}_link">
      <visual>
        <geometry><box size="0.03 0.1 0.03"/></geometry>
        <material name="sensor_black"><color rgba="0.1 0.1 0.1 0.95"/></material>
      </visual>
    </link>
    <joint name="${prefix}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}_link"/>
      <origin xyz="0.025 0 0.0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

</robot>
