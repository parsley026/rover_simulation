<?xml version="1.0"?>
<sdf version="1.8" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <world name="marsyard2020">


    <physics name="fast" type="bullet">
      <max_step_size>0.033</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    
     <plugin
        filename="gz-sim-physics-system"
        name="gz::sim::systems::Physics">
    </plugin>

      <plugin
        filename="gz-sim-scene-broadcaster-system"
        name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

        <!-- World control -->
    <plugin filename="WorldControl" name="World control">
        <gz-gui>
            <title>World control</title>
            <property type="bool" key="showTitleBar">false</property>
            <property type="bool" key="resizable">false</property>
            <property type="double" key="height">72</property>
            <property type="double" key="width">121</property>
            <property type="double" key="z">1</property>

            <property type="string" key="state">floating</property>
            <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
            </anchors>
        </gz-gui>

        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>true</start_paused>
        <service>/world/world_demo/control</service>
        <stats_topic>/world/world_demo/stats</stats_topic>
    </plugin>

    <light name="sun" type="directional">
      <pose frame="">0 0 100 0.5 0.5 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.1 0.1 -0.9</direction>
      <attenuation>
        <range>20</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <cast_shadows>1</cast_shadows>
    </light>

    <scene>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
      <shadows>true</shadows>
      <origin_visual>false</origin_visual>
    </scene>

    <!-- Marsyard -->
    <include>
      <uri>model://marsyard2020_terrain</uri>
    </include>

    <xacro:include filename="sdf/landmark.sdf.xacro"/>

    <xacro:landmark id="1">
      <pose>8.69 8.69 2.03 0 0 0</pose>
    </xacro:landmark>

    <xacro:landmark id="2">
      <pose>4.50 6.83 0.92 0 0 0</pose>
    </xacro:landmark>
  
    <xacro:landmark id="3">
      <pose>14.33 -0.43 0.95 0 0 0.86</pose>
    </xacro:landmark>

    <xacro:landmark id="4">
      <pose>-12.15 -6.52 -6.52 0 0 0.53</pose>
    </xacro:landmark>

    <xacro:landmark id="5">
      <pose>12.103476 -11.714824 -6.52 0 0 1.25</pose>
    </xacro:landmark>

    <xacro:landmark id="6">
      <pose>16.75 10.31 1.07 0 0 0.73</pose>
    </xacro:landmark>

    <xacro:landmark id="7">
      <pose>-17.67 12.68 1.03 0 0 0.19</pose>
    </xacro:landmark>

    <xacro:landmark id="8">
      <pose>-1.60 -7.46 1.44 0 0 1.16</pose>
    </xacro:landmark>

    <xacro:landmark id="9">
      <pose>12.17 7.23 1.70 0 0 1.47</pose>
    </xacro:landmark>

    <xacro:landmark id="10">
      <pose>-5.31 12.97 0.91 0 0 0.61</pose>
    </xacro:landmark>

    <xacro:landmark id="11">
      <pose>-3.91 2.30 1.10 0 0 0.16</pose>
    </xacro:landmark>

    <xacro:landmark id="12">
      <pose>-5.35 -1.57 1.93 0 0 0.21</pose>
    </xacro:landmark>

    <xacro:landmark id="13">
      <pose>-16.40 -16.40 1.09 0 0 0.61</pose>
    </xacro:landmark> 

    <xacro:landmark id="14">
      <pose>-13.46 6.05 1.35 0 0 0.73</pose>
    </xacro:landmark> 
  
    <xacro:landmark id="15">
      <pose>2.16 12.47 0.91 0 0 -0.457594</pose>
    </xacro:landmark> 

  </world>
</sdf>


