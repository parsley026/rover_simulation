<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find rover_description)/urdf/xacro/macros/sensors.xacro"/>

    <xacro:property name="lidar_mesh"       value="package://rover_description/meshes/ouster_os1.dae"/>
    <xacro:property name="lidar_mesh_scale" value="1 1 1"/>

    <xacro:property name="lidar_mesh_xyz" value="0 0 0"/>
    <xacro:property name="lidar_mesh_rpy" value="0 0 1.5708"/>

    <xacro:macro name="lidar_assembly"
                 params="parent_link:=base_link
                         lidar_center_xyz:='0 0 0.15'">

        <link name="lidar_assembly_link">
            <visual>
                <origin xyz="${lidar_mesh_xyz}" rpy="${lidar_mesh_rpy}"/>
                <geometry>
                    <mesh filename="${lidar_mesh}" scale="${lidar_mesh_scale}"/>
                </geometry>
            </visual>

            <collision>
                <origin xyz="${lidar_mesh_xyz}" rpy="${lidar_mesh_rpy}"/>
                <geometry>
                    <mesh filename="${lidar_mesh}" scale="${lidar_mesh_scale}"/>
                </geometry>
            </collision>

            <inertial>
                <origin xyz="0 0 0"/>
                <mass value="0.361"/>
                <inertia
                    ixx="0.0001"
                    ixy="0"
                    ixz="0"
                    iyy="0.0001"
                    iyz="0"
                    izz="0.0001"/>
            </inertial>
        </link>

        <joint name="lidar_assembly_joint" type="fixed">
            <parent link="${parent_link}"/>
            <child link="lidar_assembly_link"/>
            <origin xyz="${lidar_center_xyz}" rpy="0 0 0"/>
        </joint>

        <gazebo reference="lidar_assembly_link">
            <visual>
                <material>
                    <diffuse>0.75 0.75 0.75 1.0</diffuse>
                    <specular>0.95 0.95 0.95 1.0</specular>

                    <pbr>
                        <metal>
                            <albedo>0.80 0.80 0.80 1.0</albedo>
                            <roughness>0.35</roughness>
                            <metalness>1.0</metalness>
                        </metal>
                    </pbr>
                </material>
            </visual>
        </gazebo>

        <link name="lidar_assembly_frame"/>

        <joint name="lidar_assembly_frame_joint" type="fixed">
            <parent link="lidar_assembly_link"/>
            <child link="lidar_assembly_frame"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </joint>

        <xacro:lidar_sensor
            name="lidar"
            parent="lidar_assembly_link"

            lidar_topic="lidar"

            fps="10"

            horizontal_samples="256"
            horizontal_resolution="1.0"
            horizontal_min_angle="-0.785398"
            horizontal_max_angle="0.785398"

            vertical_samples="64"
            vertical_resolution="1.0"
            vertical_min_angle="-0.2897247"
            vertical_max_angle="0.2897247"

            range_resolution="0.5"
            range_min="0.8"
            range_max="10.0"

            noise_type="gaussian"
            noise_mean="0.0"
            noise_stddev="0.003"

            frame_id="lidar_assembly_frame"
        />

    </xacro:macro>

</robot>