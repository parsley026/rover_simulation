    <parent link="camera_00_rgb_camera_frame"/>
    <child link="camera_00_rgb_camera_optical_frame"/>
  </joint>
  <link name="camera_00_rgb_camera_optical_frame"/>
  <joint name="camera_00_left_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0  0.0375 0"/>
    <parent link="camera_00_link"/>
    <child link="camera_00_left_camera_frame"/>
  </joint>
  <link name="camera_00_left_camera_frame"/>
  <joint name="camera_00_left_camera_optical_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="camera_00_left_camera_frame"/>
