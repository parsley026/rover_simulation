  <link name="camera_00_model_origin"/>
  <gazebo reference="camera_00_rgb_camera_frame">
    <sensor name="camera_00_rgbd_sensor" type="rgbd_camera">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>20.0</update_rate>
      <topic>camera_00/rgbd</topic>
      <gz_frame_id>camera_00_rgb_camera_optical_frame</gz_frame_id>
      <camera>
        <horizontal_fov>2.21657</horizontal_fov>
        <image>
          <width>1280</width>
          <height>800</height>
          <format>RGB_INT8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>12.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.0</stddev>
        </noise>
        <camera_info_topic>camera_00/rgbd/camera_info</camera_info_topic>
      </camera>
      <!-- <plugin filename="libcustom_camera_noise_plugin.so" name="custom_camera_noise_plugin">
          <param1>0.1</param1>
