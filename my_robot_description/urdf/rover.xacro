    <origin xyz="-0.3099 0.472 0.2" rpy="0 0 0" />
    
      
      <geometry>
        <mesh filename="package://my_robot_description/meshes/wheel_front_left.stl" scale="0.001 0.001 0.001" />
      </geometry>
