<?xml version="1.0"?>
<robot>
     <link name="os_1">
   <visual>
     <geometry>
       <cylinder radius="0.04" length="0.07"/>
     </geometry>
     <material name="black"><color rgba="0 0 0 1"/></material>
   </visual>
   <inertial>
     <mass value="0.45"/>
     <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
   </inertial>
 </link>


 <joint name="os_1_joint" type="fixed">
   <parent link="chassis_box"/>
   <child link="os_1"/>
   <origin xyz="0 0 0.2" rpy="0 0 0"/>
 </joint>


 <gazebo reference="os_1_joint">
   <preserveFixedJoint> true </preserveFixedJoint>
 </gazebo>


 <plugin
     filename="gz-sim-sensors-system"
     name="gz::sim::systems::Sensors">
     <render_engine>ogre2</render_engine>
 </plugin>




 <gazebo reference="os_1">


 <sensor name="ouster_lidar" type="gpu_lidar">
   <always_on>true</always_on>
   <visualize>true</visualize>
   <update_rate>10</update_rate>
   <topic>points</topic>
   <gz_frame_id>os_1</gz_frame_id>


   <lidar>
     <scan>


       <!-- 360° horizontal -->
       <horizontal>
         <samples>1024</samples>
         <resolution>1</resolution>
         <min_angle>-3.14159</min_angle>
         <max_angle>3.14159</max_angle>
       </horizontal>


       <!-- 32 vertical channels (Ouster-style) -->
       <vertical>
         <samples>32</samples>
         <resolution>1</resolution>
         <min_angle>-0.52</min_angle>   <!-- -30 deg -->
         <max_angle>0.52</max_angle>    <!-- +30 deg -->
       </vertical>


     </scan>


     <range>
       <min>0.5</min>
       <max>50.0</max>
       <resolution>0.01</resolution>
     </range>
  </lidar>


   <!--<plugin
     filename="gz-sim-lidar-system"
     name="gz::sim::systems::Lidar"/>-->

   

     


 </sensor>
</gazebo>





<!--((((((((((((((((((((((((((((()))))))))))))))))))))))))))))-->

<!-- Camera Link -->
<link name="camera_link">
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="0.02 0.09 0.05"/>
    </geometry>
    <material name="camera_material">
      <color rgba="1.0 0.2 0.0 1.0"/>
    </material>
  </visual>

  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="0.02 0.09 0.05"/>
    </geometry>
  </collision>

  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="0.1"/>
    <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
  </inertial>
</link>

<joint name="camera_joint" type="fixed">
  <parent link="chassis_box"/>
  <child link="camera_link"/>
  <origin xyz="0 -0.33 0" rpy="0 0 1.6"/>
</joint>

<gazebo reference="camera_joint">
  <preserveFixedJoint>true</preserveFixedJoint>
</gazebo>





 

  





<gazebo>
  
   

 <plugin
     filename="gz-sim-ackermann-steering-system"
     name="gz::sim::systems::AckermannSteering">
    
   


     <!--<left_joint>wheel_rear_left_to_fork_rear_left</left_joint>
     <right_joint>wheel_rear_right_to_fork_rear_right</right_joint>-->
     <left_joint>wheel_front_left_to_fork_front_left</left_joint>
     <right_joint>wheel_front_right_to_fork_front_right</right_joint>






     <left_steering_joint>fork_front_left_to_suspension_arm_front_left</left_steering_joint>
     <right_steering_joint>fork_front_right_to_suspension_arm_front_right</right_steering_joint>




    


      <wheel_separation>0.6</wheel_separation>
      <wheel_base>0.8</wheel_base>
      <wheel_radius>0.2</wheel_radius>


      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>


      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>


   </plugin>



     



<plugin filename="gz-sim-joint-state-publisher-system"
                    name="gz::sim::systems::JointStatePublisher">
                    <topic>joint_states</topic>
                    <update_rate>30</update_rate>
                    <frame_id>base_link</frame_id>
                    <joint_name>wheel_rear_left_to_fork_rear_left</joint_name>
                    <joint_name>wheel_front_left_to_fork_front_left</joint_name>
                    <joint_name>wheel_rear_right_to_fork_rear_right</joint_name>
                    <joint_name>wheel_front_right_to_fork_front_right</joint_name>
                    <joint_name>fork_front_left_to_suspension_arm_front_left</joint_name>
                    <joint_name>fork_front_right_to_suspension_arm_front_right</joint_name>
                    
                    
                    
 </plugin>



 </gazebo>





</robot>