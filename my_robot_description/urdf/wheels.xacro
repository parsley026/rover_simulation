<joint name="wheel_front_right_to_fork_front_right" type="continuous">
    <parent link="fork_front_right" />
    <child link="wheel_front_right" />
    <origin xyz="0 0 -0.2" rpy="0 0 0" />
    <axis xyz="1 0 0"/>
    <dynamics friction="0.01" damping="0.1" lower="-1" upper="1" /> 
    
  </joint>

