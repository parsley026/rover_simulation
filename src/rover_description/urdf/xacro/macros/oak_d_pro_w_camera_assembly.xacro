<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find rover_description)/urdf/xacro/macros/sensors.xacro"/>

  <xacro:macro name="oak_d_pro_w_camera" params="name parent_link *origin">
    
    <xacro:property name="mesh_path"  value="$(find rover_description)/meshes/oak_d_pro_w.dae"/>
    <xacro:property name="mesh_scale" value="0.001 0.001 0.001"/>

    <xacro:property name="camera_mesh_xyz" value="-0.022 0.048 -0.00"/> 
    <xacro:property name="camera_mesh_rpy" value="1.5708 0 -1.5708"/>

    <xacro:property name="left_offset"  value="0  0.375 0"/>
    <xacro:property name="right_offset" value="0 -0.375 0"/>
    
    <joint name="${name}_center_joint" type="fixed">
      <xacro:insert_block name="origin" /> 
      <parent link="${parent_link}" />
      <child  link="${name}_center_link" />
    </joint>

    <link name="${name}_center_link">
      <visual>
        <origin xyz="${camera_mesh_xyz}" rpy="${camera_mesh_rpy}" />
        <geometry>
          <mesh filename="${mesh_path}" scale="${mesh_scale}"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="${camera_mesh_xyz}" rpy="${camera_mesh_rpy}" />
        <geometry>
          <mesh filename="${mesh_path}" scale="${mesh_scale}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.361" /> 
        <origin xyz="0 0 0" />
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
      </inertial>
    </link>

    <gazebo reference="${name}_center_link">
      <visual>
        <material>
          <diffuse>0.15 0.15 0.15 1.0</diffuse>
          <specular>0.2 0.2 0.2 1.0</specular>
          <pbr>
            <metal>
              <albedo>0.15 0.15 0.15 1.0</albedo>
              <roughness>0.6</roughness>
              <metalness>0.5</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </gazebo>

    <joint name="${name}_rgb_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <parent link="${name}_center_link" />
      <child link="${name}_rgb_optical_frame" />
    </joint>
    <link name="${name}_rgb_optical_frame"/>

    <joint name="${name}_left_joint" type="fixed">
      <origin xyz="${left_offset}" rpy="0 0 0" />
      <parent link="${name}_center_link" />
      <child link="${name}_left_link" />
    </joint>
    <link name="${name}_left_link"/>

    <joint name="${name}_left_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <parent link="${name}_left_link" />
      <child link="${name}_left_optical_frame" />
    </joint>
    <link name="${name}_left_optical_frame"/>

    <joint name="${name}_right_joint" type="fixed">
      <origin xyz="${right_offset}" rpy="0 0 0" />
      <parent link="${name}_center_link" />
      <child link="${name}_right_link" />
    </joint>
    <link name="${name}_right_link"/>

    <joint name="${name}_right_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <parent link="${name}_right_link" />
      <child link="${name}_right_optical_frame" />
    </joint>
    <link name="${name}_right_optical_frame"/>

    <xacro:camera_sensor 
        name="${name}_rgbd_sensor" 
        parent="${name}_center_link" 

        camera_topic="${name}/rgbd" 
        camera_info_topic="${name}/rgbd/camera_info" 
        type="rgbd_camera"
 
        fps="20.0"

        h_fov="2.21657" 
        width="1280" height="800" 
        format="RGB_INT8" 

        clip_near="0.10" clip_far="12.0" 
        noise_type="gaussian" noise_mean="0.0" noise_stddev="0.0"

        frame_id="${name}_rgb_optical_frame"
        />

    <xacro:camera_sensor 
        name="${name}_left_sensor" 
        parent="${name}_left_link" 

        camera_topic="${name}/left/image_raw" 
        camera_info_topic="${name}/left/camera_info"
        type="camera"

        fps="20.0" 
        
        h_fov="2.21657" 
        width="1280" height="800" 
        format="L8" 

        clip_near="0.2" clip_far="35.0" 
        noise_type="gaussian" noise_mean="0.0" noise_stddev="0.0"

        frame_id="${name}_left_optical_frame" 
        />

    <xacro:camera_sensor 
        name="${name}_right_sensor" 
        parent="${name}_right_link"

        camera_topic="${name}/right/image_raw" 
        camera_info_topic="${name}/right/camera_info"
        type="camera"
        
        fps="20.0" 
        
        h_fov="2.21657" 
        width="1280" height="800" 
        format="L8"

        clip_near="0.2" clip_far="35.0" 
        noise_type="gaussian" noise_mean="0.0" noise_stddev="0.0"
        
        frame_id="${name}_right_optical_frame" 
        />

    <xacro:imu_sensor 
        name="${name}_imu" 
        parent="${name}_center_link" 

        imu_topic="${name}/imu" 

        fps="50.0" 

        frame_id="${name}_center_link" 
        />

  </xacro:macro>
</robot>