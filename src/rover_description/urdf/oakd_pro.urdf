<!-- ************************** OAK-D PRO ************************** -->

  <!-- OAK-D PRO Camera -->
  <link name="oakd_pro_camera_center">
    <visual>
      <geometry>
        <mesh filename="package://rover_description/meshes/oak_d_pro.dae"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://rover_description/meshes/oak_d_pro.dae"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.09" />
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
    </inertial>
  </link>

  <!-- OAK-D PRO Camera Link(may need update) -->
  <joint name="oakd_pro_camera_link" type="fixed">
    <parent link="base_link" />
    <child link="oakd_pro_camera_center" />
    <origin xyz="0.38 0 0.20" rpy="0 0 0" />
  </joint>

  <!-- OAK-D PRO optical frame (camera optical axis forward) -->
  <joint name="oakd_pro_camera_optical_joint" type="fixed">
    <parent link="oakd_pro_camera_center" />
    <child link="oakd_pro_camera_optical_frame" />
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708" />
  </joint>

  <link name="oakd_pro_camera_optical_frame"/>

  <joint name="oakd_pro_left_camera_joint" type="fixed">
    <parent link="oakd_pro_camera_center"/>
    <child link="oakd_pro_camera_left"/>
    <origin xyz="0 0.375 0" rpy="0 0 0" />
  </joint>

  <link name="oakd_pro_camera_left"/>

  <joint name="oakd_pro_right_camera_joint" type="fixed">
    <parent link="oakd_pro_camera_center"/>
    <child link="oakd_pro_camera_right"/>
    <origin xyz="0 -0.375 0" rpy="0 0 0" />
  </joint>

  <link name="oakd_pro_camera_right"/>

  <gazebo reference="oakd_pro_camera_center">
    <sensor name="oakd_pro_depth" type="depth_camera">
      <always_on>true</always_on>
      <update_rate>20.0</update_rate>
      <visualize>false</visualize>
      <topic>/depth/image_raw</topic>
      <camera name="oakd_pro_depth_camera">
      <camera_info_topic>/depth/camera_info</camera_info_topic>
        <horizontal_fov>1.39626</horizontal_fov> <!-- 80 degrees -->
        <image>
          <width>640</width>
          <height>400</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.8</near>
          <far>12.0</far>
        </clip>
        <depth_camera>
          <near>0.8</near>
          <far>12.0</far>
        </depth_camera>
      </camera>
      <frame_id>oakd_pro_camera_optical_frame</frame_id>
      <gz_frame_id>oakd_pro_camera_optical_frame</gz_frame_id>
    </sensor>

    <!-- OAK-D PRO PointCloud2 -->
    <sensor name="oakd_pro_points" type="depth_camera">
      <always_on>true</always_on>
      <update_rate>20.0</update_rate>
      <visualize>false</visualize>
      <topic>/points</topic>
      <camera name="oakd_pro_points_camera">
        <horizontal_fov>1.39626</horizontal_fov>
        <image>
          <width>640</width>
          <height>400</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.8</near>
          <far>12.0</far>
        </clip>
        <point_cloud>
          <output>true</output>
        </point_cloud>
      </camera>
      <frame_id>oakd_pro_camera_optical_frame</frame_id>
      <gz_frame_id>oakd_pro_camera_optical_frame</gz_frame_id>
    </sensor>

    <!-- OAK-D PRO IMU -->
    <sensor name="oakd_pro_imu" type="imu">
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <visualize>false</visualize>
      <topic>/imu/data</topic>
      <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
      <frame_id>oakd_pro_camera_center</frame_id>
    </sensor>

    <!-- OAK-D PRO RGB camera -->
    <sensor name="oakd_pro_rgb" type="camera">
      <always_on>true</always_on>
      <update_rate>20.0</update_rate>
      <visualize>false</visualize>
      <topic>/rgb/image_raw</topic>
      <camera name="oakd_pro_rgb_camera">
        <camera_info_topic>/rgb/camera_info</camera_info_topic>
        <horizontal_fov>1.15191</horizontal_fov> <!-- 66 degrees -->
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.2</near>
          <far>5.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <frame_id>oakd_pro_camera_center</frame_id>
    </sensor>
  </gazebo>

  <gazebo reference="oakd_pro_camera_left">
    <!-- OAK-D PRO stereo left camera -->
    <sensor name="oakd_pro_stereo_left" type="camera">
      <always_on>true</always_on>
      <update_rate>20.0</update_rate>
      <visualize>false</visualize>
      <topic>/stereo/left/image_raw</topic>
      <camera name="oakd_pro_stereo_left_camera">
        <camera_info_topic>/stereo/left/camera_info</camera_info_topic>
        <horizontal_fov>1.39626</horizontal_fov>
        <image>
          <width>640</width>
          <height>400</height>
          <format>L8</format>
        </image>
        <clip>
          <near>0.8</near>
          <far>12.0</far>
        </clip>
      </camera>
      <frame_id>oakd_pro_camera_left</frame_id>
    </sensor>
  </gazebo>

  <gazebo reference="oakd_pro_camera_right">
    <!-- OAK-D PRO stereo right camera -->
    <sensor name="oakd_pro_stereo_right" type="camera">
      <always_on>true</always_on>
      <update_rate>20.0</update_rate>
      <visualize>false</visualize>
      <topic>/stereo/right/image_raw</topic>
      <camera name="oakd_pro_stereo_right_camera">
        <camera_info_topic>/stereo/right/camera_info</camera_info_topic>
        <horizontal_fov>1.39626</horizontal_fov>
        <image>
          <width>640</width>
          <height>400</height>
          <format>L8</format>
        </image>
        <clip>
          <near>0.8</near>
          <far>12.0</far>
        </clip>
      </camera>
      <frame_id>oakd_pro_camera_right</frame_id>
    </sensor>
  </gazebo>