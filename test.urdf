      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>
  <gazebo reference="lidar_00_link">
    <visual>
      <material>
        <diffuse>0.75 0.75 0.75 1.0</diffuse>
        <specular>0.95 0.95 0.95 1.0</specular>
        <pbr>
          <metal>
            <albedo>0.80 0.80 0.80 1.0</albedo>
            <roughness>0.35</roughness>
            <metalness>1.0</metalness>
          </metal>
        </pbr>
      </material>
    </visual>
  </gazebo>
  <joint name="lidar_00_lidar_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="lidar_00_link"/>
    <child link="lidar_00_lidar_frame"/>
  </joint>
  <link name="lidar_00_lidar_frame"/>
  <joint name="lidar_00_imu_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="lidar_00_link"/>
    <child link="lidar_00_imu_frame"/>
  </joint>
  <link name="lidar_00_imu_frame"/>
  <gazebo reference="lidar_00_lidar_frame">
    <sensor name="lidar_00_lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <topic>lidar_00</topic>
      <gz_frame_id>lidar_00_lidar_frame</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>256</samples>
            <resolution>1.0</resolution>
            <min_angle>-0.785398</min_angle>
            <max_angle>0.785398</max_angle>
          </horizontal>
          <vertical>
            <samples>64</samples>
            <resolution>1.0</resolution>
            <min_angle>-0.2897247</min_angle>
            <max_angle>0.2897247</max_angle>
          </vertical>
        </scan>
        <range>
          <resolution>0.5</resolution>
          <min>0.8</min>
          <max>10.0</max>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.003</stddev>
        </noise>
        <frame_id>lidar_00_lidar_frame</frame_id>
      </lidar>
    </sensor>
  </gazebo>
  <gazebo reference="lidar_00_link">
    <sensor name="lidar_00_imu" type="imu">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>50.0</update_rate>
      <topic>lidar_00/imu</topic>
      <gz_frame_id>lidar_00_imu_frame</gz_frame_id>
      <imu>
        <frame_id>lidar_00_imu_frame</frame_id>
      </imu>
    </sensor>
  </gazebo>
  

# camera sensor macro
  
  

