<?xml version="1.0" encoding="utf-8"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rover">
   <xacro:include filename="$(find my_robot_description)/urdf/rover.gazebo"/>

  <link name="base_link">
  </link>


  <link name="chassis_box">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://my_robot_description/meshes/chassis.stl"  scale="0.001 0.001 0.001" />
      </geometry>
      <material name="chassis_box">
        <color rgba="0 0 0 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://my_robot_description/meshes/chassis.stl"  scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <!--<collision>
  <origin xyz="0 0 0.06" rpy="0 0 0" />
  <geometry>
    <box size="0.4 0.3 0.1" /> 
  </geometry>
</collision>-->
    <inertial>
  <origin xyz="0 0 0" rpy="0 0 0" />
  <mass value="7.5" />
  <inertia ixx="0.1006" ixy="0.0" ixz="0.0" 
           iyy="0.0604" iyz="0.0" 
           izz="0.1498" />
</inertial>

<gazebo reference="chassis_box">
    <self_collide>false</self_collide>
</gazebo>
  </link>

  <!--<gazebo reference="chassis_box">
      <self_collide>false</self_collide>
  </gazebo>-->

  <gazebo>
   <self_collide>false</self_collide>
  </gazebo>

  <joint name="chassis_box_to_base_link" type="fixed">
    <parent link="base_link" />
    <child link="chassis_box" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 0"/>
  </joint>


<!--@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-->
   <link name="side_panel_left">
    <visual>
      <origin xyz="-0.3 0 -0.08" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://my_robot_description/meshes/side_panel_left.stl"  scale="0.001 0.001 0.001" />
      </geometry>
      <material name="panel">
         <color rgba="0.1 0.1 0.1 1" />
      </material>
    </visual>
    <collision>
     <origin xyz="-0.3 0 -0.08" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://my_robot_description/meshes/side_panel_left.stl"  scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.0040 0.0 0.0378" rpy="0 0 0" />
      <mass value="2" />
      <inertia ixx="0.0143" ixy="0.0" ixz="0.0" 
               iyy="0.0080" iyz="0.0" 
               izz="0.0072" />
    </inertial>
  </link>


  <gazebo reference="side_panel_left">
      <self_collide>false</self_collide>
  </gazebo>

  <joint name="side_panel_left_to_chassis_box" type="revolute">
    <parent link="chassis_box" />
    <child link="side_panel_left" />
    <origin xyz="0.3 0 0.08" rpy="0 0 0" />
    <axis xyz="1 0 0"/>
    <limit effort="1000.0" lower="-1" upper="1" velocity="0.5"/>
    <dynamics friction="1.0" damping="0.1"/> 
  </joint>


  <link name="side_panel_right">
    <visual>
      <origin xyz="0.3 0 -0.08" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://my_robot_description/meshes/side_panel_right.stl"  scale="0.001 0.001 0.001" />
      </geometry>
      <material name="panel">
        <color rgba="0.1 0.1 0.1 1" />
      </material>
    </visual>
    <collision>
     <origin xyz="0.3 0 -0.08" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://my_robot_description/meshes/side_panel_right.stl"  scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0040 0.0 0.0378" rpy="0 0 0" />
      <mass value="2" />
      <inertia ixx="0.0143" ixy="0.0" ixz="0.0" 
               iyy="0.0080" iyz="0.0" 
               izz="0.0072" />
    </inertial>
  </link>

  <gazebo reference="side_panel_right">
      <self_collide>false</self_collide>
  </gazebo>




  <joint name="side_panel_right_to_chassis_box" type="revolute">
    <parent link="chassis_box" />
    <child link="side_panel_right" />
    <origin xyz="-0.3 0 0.08" rpy="0 0 0" />
    <axis xyz="1 0 0"/>
    <limit effort="1000.0" lower="-1" upper="1" velocity="0.5"/>
    <dynamics friction="1.0" damping="0.1"/> 
  </joint>


<!--@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-->
<link name="suspension_arm_front_left">
    <visual>
      <origin xyz="-0.3 0.06 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://my_robot_description/meshes/suspension_arm_front_left.stl"  scale="0.001 0.001 0.001" />
      </geometry>
      <material name="arms">
        <color rgba="0 0 0 1" />
      </material>
