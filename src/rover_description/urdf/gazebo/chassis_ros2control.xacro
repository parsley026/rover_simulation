<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==========================================================================
       Chassis ros2_control Hardware Interface
       Defines 4 steer joints, 4 drive joints, and 6 passive suspension joints
       for Gazebo Sim (gz_ros2_control/GazeboSimSystem).
  ========================================================================== -->
  <ros2_control name="RoverChassisSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- 4 Actuated Steering Joints (Position Control) -->
    <joint name="steer_front_left_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="steer_front_right_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="steer_rear_left_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="steer_rear_right_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- 4 Actuated Wheel Drive Joints (Velocity Control) -->
    <joint name="drive_front_left_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="drive_front_right_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="drive_rear_left_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="drive_rear_right_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>

    <!-- 6 Passive Suspension Joints (Read-only for TF tree and closed-loop odometry) -->
    <joint name="swivel_left_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="swivel_right_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="arm_front_left_pivot">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="arm_rear_left_pivot">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="arm_front_right_pivot">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="arm_rear_right_pivot">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
