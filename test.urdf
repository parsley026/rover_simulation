  <link name="wheel_rear_right">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.13" radius="0.125"/>
      </geometry>
      <material name="wheel_rear_right-material">
        <color rgba="0.791 0.120 0 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.13" radius="0.125"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="3"/>
      <inertia ixx="0.01594375" ixy="0.0" ixz="0.0" iyy="0.01594375" iyz="0.0" izz="0.0234375"/>
    </inertial>
  </link>
  <!-- Wheel ground contact properties -->
  <gazebo reference="wheel_rear_right">
    <surface>
      <friction>
        <ode>
          <mu>1.5</mu>
          <mu2>1.5</mu2>
          <slip1>0.00062</slip1>
          <slip2>0.0</slip2>
        </ode>
        <bullet>
          <friction>1.5</friction>
          <friction2>1.5</friction2>
        </bullet>
      </friction>
      <contact>
        <ode>
          <max_contacts>10</max_contacts>
        </ode>
        <bullet>
          <soft_cfm>0.001</soft_cfm>
          <soft_erp>0.2</soft_erp>
        </bullet>
      </contact>
    </surface>
  </gazebo>
  <gazebo>
    <!-- Joint state publisher -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/world/demo/model/rex/joint_state</topic>
    </plugin>
    <!-- Pose publisher -->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <static_publisher>true</static_publisher>
      <static_update_frequency>5</static_update_frequency>
    </plugin>
    <!-- Odometry -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>/odom</odom_frame>
      <robot_base_frame>/base_link</robot_base_frame>
      <odom_publish_frequency>15</odom_publish_frequency>
      <tf_topic>/tf</tf_topic>
    </plugin>
    <!-- Differential swivel sync + bogie spring-damper -->
    <plugin filename="libdifferential_plugin.so" name="gazebo_sim_ros2_example::DifferentialPlugin">
      <jointA>base_link_to_swivel_right</jointA>
      <jointB>base_link_to_swivel_left</jointB>
      <forceConstant>60.0</forceConstant>
      <bogieJoint>arm_pivot_left_to_arm_front_left</bogieJoint>
      <bogieJoint>arm_pivot_left_to_arm_rear_left</bogieJoint>
      <bogieJoint>arm_pivot_right_to_arm_front_right</bogieJoint>
      <bogieJoint>arm_pivot_right_to_arm_rear_right</bogieJoint>
      <bogieSpring>1000</bogieSpring>
      <bogieDamping>100</bogieDamping>
    </plugin>
    <!-- ===== Steering controllers — REX VESC Steer Plugin ===== -->
    <!-- <xacro:steer_vesc_controller
          joint="arm_front_left_to_steer_front_left"
          cmd_topic="/model/rex/joint/arm_front_left_to_steer_front_left/0/cmd_pos"
          fault_vesc_id="96"/>
      <xacro:steer_vesc_controller
          joint="arm_rear_left_to_steer_rear_left"
          cmd_topic="/model/rex/joint/arm_rear_left_to_steer_rear_left/0/cmd_pos"
          fault_vesc_id="99"/>
      <xacro:steer_vesc_controller
          joint="arm_front_right_to_steer_front_right"
          cmd_topic="/model/rex/joint/arm_front_right_to_steer_front_right/0/cmd_pos"
          fault_vesc_id="97"/>
      <xacro:steer_vesc_controller
          joint="arm_rear_right_to_steer_rear_right"
          cmd_topic="/model/rex/joint/arm_rear_right_to_steer_rear_right/0/cmd_pos"
          fault_vesc_id="98"/> -->
    <!-- ===== Drive controllers — REX VESC Drive Plugin ===== -->
    <!-- <xacro:drive_vesc_controller
