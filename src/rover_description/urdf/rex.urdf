<robot name="rex">
  <!-- <link name="base_footprint"></link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint> -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.7 0.44 0.176" />
      </geometry>
      <material name="base_link-material">
        <color rgba="1 0.36625259558833256 0.06480326668529614 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.7 0.44 0.176" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="15" />
      <inertia ixx="0.28072" ixy="0" ixz="0" iyy="0.65122" iyz="0" izz="0.8545" />
    </inertial>
  </link>
  <joint name="base_link_to_swivel_left" type="revolute">
    <parent link="base_link" />
    <child link="swivel_left" />
    <origin xyz="0 0.2735 0" rpy="0 0 0" />
    <axis xyz="0 1 0"/>
    <limit effort="1000.0" lower="-1" upper="1" velocity="5.0"/>
    <dynamics friction="1.0" damping="0.1"/> 
  </joint>
  <link name="swivel_left">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963267948963 0 0" />
      <geometry>
        <cylinder radius="0.01" length="0.107" />
      </geometry>
      <material name="swivel_left-material">
        <color rgba="0.3231432091022285 0.31854677811435356 0.3049873140591091 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267948963 0 0" />
      <geometry>
        <cylinder radius="0.01" length="0.107" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.001" />
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001" />
    </inertial>
  </link>
  <joint name="swivel_left_to_arm_left" type="fixed">
    <parent link="swivel_left" />
    <child link="arm_left" />
    <origin xyz="0 0.0535 0" rpy="0 0 0" />
    <!-- <axis xyz="0 1 0"/>
    <limit effort="1000.0" lower="-1" upper="1" velocity="5.0"/> -->
    </joint> 
  <link name="arm_left">
