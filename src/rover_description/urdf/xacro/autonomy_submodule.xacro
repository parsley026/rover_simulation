<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="autonomy_submodule" params="name parent_link">

        <link name="mount_link">
            <inertial>
                <mass value="0.1"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
            </inertial>
        </link>
        

        <joint name="mount_link_joint" type="fixed">
            <parent link="${parent_link}"/>
            <child link="mount_link"/>
            <origin xyz="0.27 0.0 0.0" rpy="0 0 3.14159265359"/>
            <axis xyz="0 0 1"/>
            <limit effort="5" velocity="1.0" lower="-3.14" upper="3.14"/>
        </joint>

        <link name="sensor_mount_00_link">
            <inertial>
                <mass value="0.05"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
            </inertial>
        </link>

        <joint name="sensor_mount_00_joint" type="fixed">
            <parent link="mount_link"/>
            <child link="sensor_mount_00_link"/>
            <origin xyz="-0.12 0.0 0.22" rpy="0 0 3.14159265359"/>
            <axis xyz="0 0 1"/>
            <limit effort="5" velocity="1.0" lower="-3.14" upper="3.14"/>
        </joint>

        <link name="sensor_mount_01_link">
            <inertial>
                <mass value="0.05"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
            </inertial>
        </link>

        <joint name="sensor_mount_01_joint" type="fixed">
            <parent link="mount_link"/>
            <child link="sensor_mount_01_link"/>
            <origin xyz="-0.05 0.0 0.3" rpy="0 0 3.14159265359"/>
            <axis xyz="0 0 1"/>
            <limit effort="5" velocity="1.0" lower="-3.14" upper="3.14"/>
        </joint>

        <xacro:include filename="$(find rover_description)/urdf/macros/assembly/camera/oak_d_pro_w_camera_assembly.xacro"/>
        
        <xacro:oak_d_pro_w_camera 
            name="camera_00" 
            parent_link="sensor_mount_00_link">

            <origin xyz="0.0 0.0 0.00" rpy="0 0 0" />
        </xacro:oak_d_pro_w_camera>

        <xacro:include filename="$(find rover_description)/urdf/macros/assembly/lidar/ouster_os1_lidar_assembly.xacro"/>
        
        <xacro:ouster_os1_lidar 
            name="lidar_00" 
            parent_link="sensor_mount_01_link">

            <origin xyz="0.0 0.0 0.0" rpy="0 0.2618 0" />
        </xacro:ouster_os1_lidar>

    </xacro:macro>

</robot>