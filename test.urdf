  </gazebo>
  <link name="mount_link">
    <inertial>
      <mass value="0.1"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="mount_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mount_link"/>
    <origin rpy="0 0 3.14159265359" xyz="0.27 0.0 0.0"/>
    <axis xyz="0 0 1"/>
    <limit effort="5" lower="-3.14" upper="3.14" velocity="1.0"/>
  </joint>
  <link name="sensor_mount_00_link">
    <inertial>
      <mass value="0.05"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="sensor_mount_00_joint" type="fixed">
    <parent link="mount_link"/>
    <child link="sensor_mount_00_link"/>
    <origin rpy="0 0 3.14159265359" xyz="-0.12 0.0 0.22"/>
    <axis xyz="0 0 1"/>
    <limit effort="5" lower="-3.14" upper="3.14" velocity="1.0"/>
  </joint>
  <link name="sensor_mount_01_link">
    <inertial>
      <mass value="0.05"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="sensor_mount_01_joint" type="fixed">
    <parent link="mount_link"/>
    <child link="sensor_mount_01_link"/>
    <origin rpy="0 0 3.14159265359" xyz="-0.05 0.0 0.3"/>
    <axis xyz="0 0 1"/>
    <limit effort="5" lower="-3.14" upper="3.14" velocity="1.0"/>
  </joint>
  

