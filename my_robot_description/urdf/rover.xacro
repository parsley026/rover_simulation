<gazebo reference="wheel_front_left">
   <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>10000000.0</kp> <kd>10.0</kd> <minDepth>0.005</minDepth>
    <maxVel>0</maxVel>
    <fdir1>1 0 0</fdir1>
</gazebo>
  


