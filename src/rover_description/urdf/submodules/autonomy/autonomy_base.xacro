<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="autonomy_base" params="name parent_link module_position_front:=true module_position_back:=false sensor_mount_00_pitch:=0.0 sensor_mount_01_pitch:=0.0">

        <!-- ========================================== -->
        <!--            AUTONOMY SUBMODULE              -->
        <!-- ========================================== -->

        <link name="module_base_mount">
            <visual><geometry><box size="0.12 0.15 0.02"/></geometry><material name="mount_dark_gray"/></visual>
        </link>
        
        <xacro:if value="${module_position_front}">
            <joint name="module_base_mount_joint" type="fixed">
                <parent link="robot_base_front_mount"/>
                <child link="module_base_mount"/>
                <origin xyz="0.015 0.0 0.02" rpy="0 0 0"/>
            </joint>
        </xacro:if>

        <xacro:if value="${module_position_back}">
            <joint name="module_base_mount_joint" type="fixed">
                <parent link="robot_base_back_mount"/>
                <child link="module_base_mount"/>
                <origin xyz="0.00 0.0 0.05" rpy="0 0 3.14159265"/>
            </joint>
        </xacro:if>

        <xacro:if value="${not module_position_front and not module_position_back}">
            <joint name="module_base_mount_joint" type="fixed">
                <parent link="${parent_link}"/>
                <child link="module_base_mount"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </joint>
        </xacro:if>

        <link name="module_base">
            <visual><geometry><box size="0.12 0.15 0.23"/></geometry><material name="tower_yellow"/></visual>
        </link>
        <joint name="module_base_joint" type="fixed">
            <parent link="module_base_mount"/>
            <child link="module_base"/>
            <origin xyz="0.0 0.0 0.125" rpy="0 0 0"/>
        </joint>

        <!-- Mount 00 (Lidar Plate) -->
        <link name="sensor_mount_00_pivot_link">
            <visual><origin xyz="0 0 0" rpy="1.570796 0 0"/><geometry><cylinder radius="0.005" length="0.105"/></geometry><material name="mount_red"/></visual>
            <xacro:inertial_cylinder mass="0.01" length="0.105" radius="0.005"><origin xyz="0 0 0" rpy="1.570796 0 0"/></xacro:inertial_cylinder>
        </link>
        <joint name="sensor_mount_00_pivot_joint" type="fixed">
            <parent link="module_base"/>
            <child link="sensor_mount_00_pivot_link"/>
            <origin xyz="0.06 0.0 0.12" rpy="0 ${sensor_mount_00_pitch * pi / 180.0} 0"/>
        </joint>
        <link name="sensor_mount_00_link">
            <visual><geometry><box size="0.11 0.105 0.01"/></geometry><material name="mount_red"/></visual>
            <xacro:inertial_box mass="0.01" x="0.11" y="0.105" z="0.01"><origin xyz="0 0 0" rpy="0 0 0"/></xacro:inertial_box>
        </link>
        <joint name="sensor_mount_00_joint" type="fixed">
            <parent link="sensor_mount_00_pivot_link"/>
            <child link="sensor_mount_00_link"/>
            <origin xyz="-0.055 0.0 0.0" rpy="0 0 0"/>
        </joint>

        <!-- Mount 01 (Lower Camera) -->
        <link name="sensor_mount_01_pivot_link">
            <visual><origin xyz="0 0 0" rpy="1.570796 0 0"/><geometry><cylinder radius="0.005" length="0.12"/></geometry><material name="mount_green"/></visual>
            <xacro:inertial_cylinder mass="0.01" length="0.12" radius="0.005"><origin xyz="0 0 0" rpy="1.570796 0 0"/></xacro:inertial_cylinder>
        </link>
        <joint name="sensor_mount_01_pivot_joint" type="fixed">
            <parent link="module_base"/>
            <child link="sensor_mount_01_pivot_link"/>
            <origin xyz="0.050 0.0 0.025" rpy="0 ${sensor_mount_01_pitch * pi / 180.0} 0"/>
        </joint>
        <link name="sensor_mount_01_link">
            <visual><geometry><box size="0.02 0.12 0.04"/></geometry><material name="mount_green"/></visual>
            <xacro:inertial_box mass="0.01" x="0.02" y="0.12" z="0.04"><origin xyz="0 0 0" rpy="0 0 0"/></xacro:inertial_box>
        </link>
        <joint name="sensor_mount_01_joint" type="fixed">
            <parent link="sensor_mount_01_pivot_link"/>
            <child link="sensor_mount_01_link"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </joint>

    </xacro:macro>

</robot>
