  <gazebo reference='wheel_front_left'>
    <kp  value="10000000.0" />
    <kd  value="10.0" />
    <fdir1 value="1 0 0"/>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <maxContacts>5</maxContacts>
    <!-- <collision>
      <surface>
        <contact>
          <ode>
