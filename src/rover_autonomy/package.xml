<?xml version="1.0"?>
<package format="3">
  <name>rover_autonomy</name>
  <version>0.0.0</version>
  <description>Autonomy subsystem — supervisor, watchdog, and pipeline bringup for the rover.</description>

  <maintainer email="me@email.com">me_name</maintainer>

  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- Core ROS 2 -->
  <build_depend>rclcpp</build_depend>
  <build_depend>rclcpp_lifecycle</build_depend>
  <build_depend>rclcpp_components</build_depend>
  <build_depend>ament_index_cpp</build_depend>

  <exec_depend>rclcpp</exec_depend>
  <exec_depend>rclcpp_lifecycle</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>ament_index_cpp</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  
  <depend>tf2_msgs</depend>

  <!-- Python launch support -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
