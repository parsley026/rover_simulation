# lidar sensor macro
  
  <!-- ── Base Joint connecting to the robot mount plate ── -->
  <joint name="camera_01_base_joint" type="fixed">
    <parent link="sensor_mount_01_link"/>
    <child link="camera_01_camera_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0365 0.0 -0.015"/>
  </joint>
  <!-- ── Base Link (mounting screw hole reference) ── -->
  <link name="camera_01_camera_link"/>
  <!-- ── Camera Center (carries mesh + internal sensor origins) ── -->
  <link name="camera_01_camera_center">
    <visual>
      <origin rpy="0 0 0" xyz="-0.01 0 0"/>
      <geometry>
        <mesh filename="package://rover_description/meshes/sensors/camera/stereolabs/zed.dae" scale="1 1 1"/>
      </geometry>
      <material name="zed2i_mat">
        <color rgba="0.25 0.25 0.25 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="-0.01 0 0"/>
      <geometry>
        <box size="0.03 0.175 0.033"/>
      </geometry>
    </collision>
  </link>
  <joint name="camera_01_camera_center_joint" type="fixed">
    <parent link="camera_01_camera_link"/>
    <child link="camera_01_camera_center"/>
    <origin rpy="0 0 0" xyz="0 0 0.015"/>
  </joint>
  <!-- ── Left Camera frame ── -->
  <link name="camera_01_left_camera_frame"/>
  <joint name="camera_01_left_camera_joint" type="fixed">
    <parent link="camera_01_camera_center"/>
    <child link="camera_01_left_camera_frame"/>
    <origin rpy="0 0 0" xyz="-0.01 0.06 0"/>
  </joint>
  <link name="camera_01_left_camera_frame_optical"/>
  <joint name="camera_01_left_camera_joint_optical" type="fixed">
    <origin rpy="-1.5707963267948966 0.0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="camera_01_left_camera_frame"/>
    <child link="camera_01_left_camera_frame_optical"/>
  </joint>
  <!-- ── Right Camera frame ── -->
  <link name="camera_01_right_camera_frame"/>
  <joint name="camera_01_right_camera_joint" type="fixed">
    <parent link="camera_01_camera_center"/>
    <child link="camera_01_right_camera_frame"/>
    <origin rpy="0 0 0" xyz="-0.01 -0.06 0"/>
  </joint>
  <link name="camera_01_right_camera_frame_optical"/>
  <joint name="camera_01_right_camera_joint_optical" type="fixed">
    <origin rpy="-1.5707963267948966 0.0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="camera_01_right_camera_frame"/>
    <child link="camera_01_right_camera_frame_optical"/>
  </joint>
  <!-- ── Internal sensor frames (required by ZED SDK / ROS 2 wrapper) ── -->
  <link name="camera_01_imu_link"/>
  <joint name="camera_01_imu_joint" type="fixed">
    <parent link="camera_01_camera_center"/>
    <child link="camera_01_imu_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="camera_01_mag_link"/>
  <joint name="camera_01_mag_joint" type="fixed">
    <parent link="camera_01_camera_center"/>
    <child link="camera_01_mag_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="camera_01_baro_link"/>
  <joint name="camera_01_baro_joint" type="fixed">
    <parent link="camera_01_camera_center"/>
    <child link="camera_01_baro_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="camera_01_temp_left_link"/>
  <joint name="camera_01_temp_left_joint" type="fixed">
    <parent link="camera_01_left_camera_frame"/>
    <child link="camera_01_temp_left_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="camera_01_temp_right_link"/>
  <joint name="camera_01_temp_right_joint" type="fixed">
    <parent link="camera_01_right_camera_frame"/>
    <child link="camera_01_temp_right_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  

# camera sensor macro
  
  

# imu sensor macro
  
  

# lidar sensor macro
  
  <joint name="camera_03_base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="sensor_mount_03_link"/>
    <child link="camera_03_link"/>
  </joint>
  <link name="camera_03_link">
    <!-- Main camera body (Square/Box) -->
    <visual>
      <origin rpy="0 0 0" xyz="0.0248 0 0"/>
      <geometry>
        <box size="0.0496 0.0315 0.0315"/>
      </geometry>
      <material name="camera_03_dark_gray">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
    <!-- Circle in front for reference -->
    <visual>
      <origin rpy="0 1.5708 0" xyz="0.0496 0 0"/>
      <geometry>
        <cylinder length="0.002" radius="0.01"/>
      </geometry>
      <material name="camera_03_lens_black">
        <color rgba="0.0 0.0 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0.0248 0 0"/>
      <geometry>
        <box size="0.0496 0.0315 0.0315"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.093"/>
      <origin xyz="0.0248 0 0"/>
      <inertia ixx="0.000015" ixy="0.0" ixz="0.0" iyy="0.000027" iyz="0.0" izz="0.000027"/>
    </inertial>
  </link>
  <gazebo reference="camera_03_link">
    <visual>
      <material>
        <diffuse>0.15 0.15 0.15 1.0</diffuse>
        <specular>0.2 0.2 0.2 1.0</specular>
        <pbr>
          <metal>
            <albedo>0.15 0.15 0.15 1.0</albedo>
            <roughness>0.6</roughness>
            <metalness>0.5</metalness>
          </metal>
        </pbr>
      </material>
    </visual>
  </gazebo>
  <link name="camera_03_rgb_camera_frame"/>
  <joint name="camera_03_rgb_camera_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.0496 0 0"/>
    <parent link="camera_03_link"/>
    <child link="camera_03_rgb_camera_frame"/>
  </joint>
  <link name="camera_03_rgb_camera_optical_frame"/>
  <joint name="camera_03_rgb_camera_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0.0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="camera_03_rgb_camera_frame"/>
    <child link="camera_03_rgb_camera_optical_frame"/>
  </joint>
  <gazebo reference="camera_03_link">
    <sensor name="camera_03_rgb_sensor" type="camera">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>60.0</update_rate>
      <topic>camera_03/image_raw</topic>
      <gz_frame_id>camera_03_rgb_camera_optical_frame</gz_frame_id>
      <camera>
        <horizontal_fov>1.8814</horizontal_fov>
        <image>
          <width>1920</width>
          <height>1080</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
        <camera_info_topic>camera_03/camera_info</camera_info_topic>
      </camera>
      <!-- <plugin filename="libcustom_camera_noise_plugin.so" name="custom_camera_noise_plugin">
          <param1>0.1</param1>
          <param2>0.05</param2>

          <topic>${camera_topic}</topic>
        </plugin> -->
      <frame_id>camera_03_rgb_camera_optical_frame</frame_id>
    </sensor>
  </gazebo>
  

