<?xml version="1.0"?>
<robot name="oakd" xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Parametry konfiguracyjne -->
  <xacro:property name="oakd_center_xyz" value="0.38 0 0.10"/>
  <xacro:property name="oakd_left_offset" value="0 0.375 0"/>
  <xacro:property name="oakd_right_offset" value="0 -0.375 0"/>
  <xacro:property name="oakd_mesh" value="package://rover_description/meshes/oak_d.dae"/>

  <!-- Kamery stereo -->
  <xacro:macro name="oakd_stereo_camera" params="name parent_link offset frame_id topic camera_info_topic joint_name">
    <link name="${name}"/>
    <joint name="${joint_name}" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${name}"/>
      <origin xyz="${offset}" rpy="0 0 0"/>
    </joint>
    <gazebo reference="${name}">
      <sensor name="${name}_sensor" type="camera">
        <always_on>true</always_on>
        <update_rate>20.0</update_rate>
        <visualize>false</visualize>
        <topic>${topic}</topic>
        <camera name="${name}_camera">
          <xacro:if value="${camera_info_topic != ''}">
            <camera_info_topic>${camera_info_topic}</camera_info_topic>
          </xacro:if>
          <horizontal_fov>1.25663</horizontal_fov>
          <image>
            <width>640</width>
            <height>400</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.8</near>
            <far>12.0</far>
          </clip>
        </camera>
        <frame_id>${frame_id}</frame_id>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- Lewa kamera stereo -->
  <xacro:oakd_stereo_camera 
    name="oakd_camera_left" 
    parent_link="oakd_camera_center" 
    offset="${oakd_left_offset}" 
    frame_id="oakd_camera_left" 
    topic="/stereo/left/image_raw" 
    camera_info_topic="/stereo/left/camera_info"/>

  <!-- Prawa kamera stereo -->
  <xacro:oakd_stereo_camera 
    name="oakd_camera_right" 
    parent_link="oakd_camera_center" 
    offset="${oakd_right_offset}" 
    frame_id="oakd_camera_right" 
    topic="/stereo/right/image_raw" 
    camera_info_topic="/stereo/right/camera_info"/>


  <!-- Makro dla sensora depth_camera (depth lub pointcloud) -->
  <xacro:macro name="oakd_depth_sensor" params="name topic camera_info_topic frame_id output_type">
    <gazebo reference="oakd_camera_center">
      <sensor name="${name}" type="depth_camera">
        <always_on>true</always_on>
        <update_rate>20.0</update_rate>
        <visualize>false</visualize>
        <topic>${topic}</topic>
        <camera name="${name}_camera">
          <camera_info_topic>${camera_info_topic}</camera_info_topic>
          <horizontal_fov>1.25663</horizontal_fov>
          <image>
            <width>640</width>
            <height>400</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.8</near>
            <far>12.0</far>
          </clip>
          <xacro:if value="${output_type == 'pointcloud'}">
            <point_cloud>
              <output>true</output>
            </point_cloud>
          </xacro:if>
          <xacro:if value="${output_type == 'depth'}">
            <depth_camera>
              <near>0.8</near>
              <far>12.0</far>
            </depth_camera>
          </xacro:if>
        </camera>
        <frame_id>${frame_id}</frame_id>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- Makro dla RGB camera -->
  <xacro:macro name="oakd_rgb_sensor" params="name topic camera_info_topic frame_id">
    <gazebo reference="oakd_camera_center">
      <sensor name="${name}" type="camera">
        <always_on>true</always_on>
        <update_rate>20.0</update_rate>
        <visualize>false</visualize>
        <topic>${topic}</topic>
        <camera name="${name}_camera">
          <camera_info_topic>${camera_info_topic}</camera_info_topic>
          <horizontal_fov>1.20427</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.2</near>
            <far>5.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <frame_id>${frame_id}</frame_id>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- Makro dla IMU -->
  <xacro:macro name="oakd_imu_sensor" params="name topic frame_id">
    <gazebo reference="oakd_camera_center">
      <sensor name="${name}" type="imu">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <visualize>false</visualize>
        <topic>${topic}</topic>
        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
        <frame_id>${frame_id}</frame_id>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- Główne makro modułu OAK-D -->
  <xacro:macro name="oakd_module" params="parent_link:=base_link">
    <!-- Główny korpus OAK-D -->
    <link name="oakd_camera_center">
      <visual>
        <geometry>
          <mesh filename="${oakd_mesh}"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="${oakd_mesh}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" />
        <mass value="0.1" />
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
      </inertial>
    </link>

    <!-- Joint do bazy (parametryzowany) -->
    <joint name="oakd_camera_link" type="fixed">
      <parent link="${parent_link}" />
      <child link="oakd_camera_center" />
      <origin xyz="${oakd_center_xyz}" rpy="0 0 0" />
    </joint>

    <!-- Lewa kamera stereo -->
    <xacro:oakd_stereo_camera 
      name="oakd_camera_left" 
      parent_link="oakd_camera_center" 
      offset="${oakd_left_offset}" 
      frame_id="oakd_camera_left" 
      topic="/stereo/left/image_raw" 
      camera_info_topic="/stereo/left/camera_info"
      joint_name="oakd_left_camera_joint"/>

    <!-- Prawa kamera stereo -->
    <xacro:oakd_stereo_camera 
      name="oakd_camera_right" 
      parent_link="oakd_camera_center" 
      offset="${oakd_right_offset}" 
      frame_id="oakd_camera_right" 
      topic="/stereo/right/image_raw" 
      camera_info_topic="/stereo/right/camera_info"
      joint_name="oakd_right_camera_joint"/>

    <!-- Depth (image) -->
    <xacro:oakd_depth_sensor 
      name="oakd_depth" 
      topic="/depth/image_raw" 
      camera_info_topic="/depth/camera_info" 
      frame_id="oakd_camera_center" 
      output_type="depth"/>

    <!-- PointCloud2 -->
    <xacro:oakd_depth_sensor 
      name="oakd_points" 
      topic="/points" 
      camera_info_topic="" 
      frame_id="oakd_camera_center" 
      output_type="pointcloud"/>

    <!-- RGB camera -->
    <xacro:oakd_rgb_sensor 
      name="oakd_rgb" 
      topic="/rgb/image_raw" 
      camera_info_topic="/rgb/camera_info" 
      frame_id="oakd_camera_center"/>

    <!-- IMU -->
    <xacro:oakd_imu_sensor 
      name="oakd_imu" 
      topic="/imu/data" 
      frame_id="oakd_camera_center"/>
  </xacro:macro>

</robot>
